import os
import logging

from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import (
    Application,
    CommandHandler,
    CallbackQueryHandler,
    MessageHandler,
    ContextTypes,
    filters,
)

logging.basicConfig(level=logging.INFO)

BOT_TOKEN = os.getenv("BOT_TOKEN")

OWNER = "Mr_Giyu07"
DEVELOPER = "Dr_Doom06"

ANIME_LIST = [
    "Naruto",
    "Naruto Shippuden",
    "Demon Slayer",
    "Death Note",
    "One Punch Man",
    "Jujutsu Kaisen",
    "Attack on Titan",
    "Dragon Ball Super",
    "Black Clover",
    "My Hero Academia",
    "Tokyo Revengers",
    "Solo Leveling",
def main_menu():
    return InlineKeyboardMarkup([
        [
            InlineKeyboardButton(
                "🇮🇳 Hindi Dubbed Anime",
                callback_data="anime"
            )
        ],
        [
            InlineKeyboardButton(
                "🔎 Search Anime",
                callback_data="search"
            )
        ],
        [
            InlineKeyboardButton(
                "ℹ️ About",
                callback_data="about"
            )
        ],
    ])


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data["search_mode"] = False

    await update.message.reply_text(
        "👋 <b>Welcome to Anime Bot</b>\n\n"
        "🇮🇳 Hindi Dubbed Anime Catalog\n\n"
        "👇 Apna option select karo.",
        parse_mode="HTML",
        reply_markup=main_menu(),
    )async def button_handler(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):
    query = update.callback_query
    await query.answer()

    data = query.data

    if data == "anime":
        context.user_data["search_mode"] = False

        buttons = []

        for anime in ANIME_LIST:
            buttons.append([
                InlineKeyboardButton(
                    f"🎬 {anime}",
                    callback_data=f"anime_{anime}"
                )
            ])

        buttons.append([
            InlineKeyboardButton(
                "⬅️ Back",
                callback_data="back"
            )
        ])

        await query.edit_message_text(
            "🇮🇳 <b>Hindi Dubbed Anime</b>\n\n"
            "👇 Anime select karo:",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup(buttons),
        )

    elif data == "search":
        context.user_data["search_mode"] = True

        await query.edit_message_text(
            "🔎 <b>Search Anime</b>\n\n"
            "Anime ka naam bhejo.\n\n"
            "Example: <code>Naruto</code>",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup([
                [
                    InlineKeyboardButton(
                        "⬅️ Back",
                        callback_data="back"
                    )
                ]
            ]),
        ) 
elif data == "about":
        context.user_data["search_mode"] = False

        await query.edit_message_text(
            "ℹ️ <b>About Anime Bot</b>\n\n"
            "🎌 Hindi Dubbed Anime Catalog Bot\n\n"
            f"👑 <b>Owner:</b> {OWNER}\n"
            f"👨‍💻 <b>Developer:</b> {DEVELOPER}\n\n"
            f"🔗 Owner: @{OWNER}\n"
            f"🔗 Developer: @{DEVELOPER}",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup([
                [
                    InlineKeyboardButton(
                        f"👑 @{OWNER}",
                        url=f"https://t.me/{OWNER}"
                    )
                ],
                [
                    InlineKeyboardButton(
                        f"👨‍💻 @{DEVELOPER}",
                        url=f"https://t.me/{DEVELOPER}"
                    )
                ],
                [
                    InlineKeyboardButton(
                        "⬅️ Back",
                        callback_data="back"
                    )
                ],
            ]),
        )

    elif data == "back":
        context.user_data["search_mode"] = False

        await query.edit_message_text(
            "👋 <b>Welcome to Anime Bot</b>\n\n"
            "🇮🇳 Hindi Dubbed Anime Catalog\n\n"
            "👇 Apna option select karo.",
            parse_mode="HTML",
            reply_markup=main_menu(),
        )
elif data.startswith("anime_"):
        anime_name = data.replace("anime_", "", 1)

        await query.edit_message_text(
            f"🎬 <b>{anime_name}</b>\n\n"
            "🇮🇳 Hindi Dubbed Anime\n"
            "📺 Anime selected successfully.",
            parse_mode="HTML",
        ) 
async def message_handler(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):
    if not context.user_data.get("search_mode"):
        return

    search = update.message.text.strip().lower()

    results = [
        anime for anime in ANIME_LIST
        if search in anime.lower()
    ] if results:
        buttons = []

        for anime in results:
            buttons.append([
                InlineKeyboardButton(
                    f"🎬 {anime}",
                    callback_data=f"anime_{anime}"
                )
            ])

        await update.message.reply_text(
            "🔎 <b>Search Results</b>",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup(buttons),
        ) 
else:
        await update.message.reply_text(
            "❌ Anime nahi mila.\n\n"
            "Dusra naam try karo."
        )


def main():
    if not BOT_TOKEN:
        raise ValueError(
            "BOT_TOKEN missing!"
        )

    app = Application.builder().token(BOT_TOKEN).build()

    app.add_handler(
        CommandHandler("start", start)
    )

    app.add_handler(
        CallbackQueryHandler(button_handler)
    ) app.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            message_handler
        )
    )

    print("🤖 Anime Bot Started!")

    app.run_polling()


if __name__ == "__main__":
    main()
