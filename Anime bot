main.pyimport os
import logging

from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import (
    Application,
    CommandHandler,
    CallbackQueryHandler,
    MessageHandler,
    ContextTypes,
    filters,
)

logging.basicConfig(level=logging.INFO)

BOT_TOKEN = os.getenv("BOT_TOKEN")

OWNER = "Mr_Giyu07"
DEVELOPER = "Dr_Doom06"

ANIME_LIST = [
    "Naruto",
    "Naruto Shippuden",
    "Demon Slayer",
    "Death Note",
    "One Punch Man",
    "Jujutsu Kaisen",
    "Attack on Titan",
    "Dragon Ball Super",
    "Black Clover",
    "My Hero Academia",
    "Tokyo Revengers",
    "Solo Leveling",
]


def main_menu():
    return InlineKeyboardMarkup([
        [
            InlineKeyboardButton(
                "🇮🇳 Hindi Dubbed Anime",
                callback_data="anime"
            )
        ],
        [
            InlineKeyboardButton(
                "🔎 Search Anime",
                callback_data="search"
            )
        ],
        [
            InlineKeyboardButton(
                "ℹ️ About",
                callback_data="about"
            )
        ],
    ])


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data["search_mode"] = False

    await update.message.reply_text(
        "👋 <b>Welcome to Anime Bot</b>\n\n"
        "🇮🇳 Hindi Dubbed Anime Catalog\n\n"
        "👇 Apna option select karo.",
        parse_mode="HTML",
        reply_markup=main_menu(),
    )


async def button_handler(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):
    query = update.callback_query
    await query.answer()

    if query.data == "anime":
        keyboard = []

        for anime in ANIME_LIST:
            keyboard.append([
                InlineKeyboardButton(
                    f"🎬 {anime}",
                    callback_data="info_" + anime
                )
            ])

        keyboard.append([
            InlineKeyboardButton(
                "🔙 Back",
                callback_data="back"
            )
        ])

        await query.edit_message_text(
            "🇮🇳 <b>Hindi Dubbed Anime</b>\n\n"
            "👇 Anime select karo:",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup(keyboard),
        )

    elif query.data == "search":
        context.user_data["search_mode"] = True

        await query.edit_message_text(
            "🔎 <b>Anime Search</b>\n\n"
            "Anime ka naam message me bhejo.\n\n"
            "Example: <code>Naruto</code>",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup([
                [
                    InlineKeyboardButton(
                        "🔙 Back",
                        callback_data="back"
                    )
                ]
            ]),
        )

    elif query.data == "about":
        keyboard = [
            [
                InlineKeyboardButton(
                    "👑 Owner",
                    url="https://t.me/Mr_Giyu07"
                )
            ],
            [
                InlineKeyboardButton(
                    "👨‍💻 Developer",
                    url="https://t.me/Dr_Doom06"
                )
            ],
            [
                InlineKeyboardButton(
                    "🔙 Back",
                    callback_data="back"
                )
            ],
        ]

        await query.edit_message_text(
            "ℹ️ <b>ABOUT BOT</b>\n\n"
            f"👑 Owner : @{OWNER}\n"
            f"👨‍💻 Developer : @{DEVELOPER}\n\n"
            "🇮🇳 Hindi Dubbed Anime Catalog Bot",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup(keyboard),
        )

    elif query.data == "back":
        context.user_data["search_mode"] = False

        await query.edit_message_text(
            "🏠 <b>Main Menu</b>\n\n"
            "👇 Option select karo.",
            parse_mode="HTML",
            reply_markup=main_menu(),
        )

    elif query.data.startswith("info_"):
        anime_name = query.data[5:]

        await query.edit_message_text(
            f"🎬 <b>{anime_name}</b>\n\n"
            "🇮🇳 Hindi Dubbed Catalog\n\n"
            "ℹ️ Anime catalog information.",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup([
                [
                    InlineKeyboardButton(
                        "🔙 Anime List",
                        callback_data="anime"
                    )
                ],
                [InlineKeyboardButton(
                        "🏠 Main Menu",
                        callback_data="back"
                    )
                ],
            ]),
        )


async def search_handler(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):
    if not context.user_data.get("search_mode"):
        return

    search = update.message.text.strip().lower()

    results = [
        anime
        for anime in ANIME_LIST
        if search in anime.lower()
    ]

    if results:
        text = "🔎 <b>Search Results</b>\n\n"

        for anime in results:
            text += f"🎬 {anime}\n"
    else:
        text = (
            "❌ <b>Anime nahi mila.</b>\n\n"
            "Dusra naam try karo."
        )

    context.user_data["search_mode"] = False

    await update.message.reply_text(
        text,
        parse_mode="HTML",
        reply_markup=InlineKeyboardMarkup([
            [
                InlineKeyboardButton(
                    "🇮🇳 Anime List",
                    callback_data="anime"
                )
            ],
            [
                InlineKeyboardButton(
                    "🏠 Main Menu",
                    callback_data="back"
                )
            ],
        ]),
    )


def run_bot():
    if not BOT_TOKEN:
        raise RuntimeError(
            "BOT_TOKEN Railway Variables me set nahi hai."
        )

    app = Application.builder().token(BOT_TOKEN).build()

    app.add_handler(
        CommandHandler("start", start)
 )

    app.add_handler(
        CallbackQueryHandler(button_handler)
    )

    app.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            search_handler
        )
    )

    print("🤖 Anime Bot Started!")

    app.run_polling()


if __name__ == "__main__":
    run_bot()
